# Backend: extractive (no LLM, works offline) | ollama (local) | openai (any OpenAI-compatible API)
STUDYKIT_BACKEND=extractive
STUDYKIT_MODEL=llama3.2:3b
# Ollama default: http://localhost:11434 ; OpenAI-compatible example: https://api.openai.com/v1
STUDYKIT_BASE_URL=http://localhost:11434
STUDYKIT_API_KEY=
STUDYKIT_CHUNK_CHARS=6000
STUDYKIT_MAX_UPLOAD_MB=10
